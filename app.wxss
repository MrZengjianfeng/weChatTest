/* 全局色板 / 字号，组件 isolated 仍可继承这些 CSS 变量 */
page {
  --color-primary: #00c853;
  --color-primary-dark: #0b3d2e;
  --color-primary-deep: #006c41;
  --color-text: #111111;
  --color-text-secondary: #5e7d67;
  --color-bg: #eef3ee;
  --color-surface: #ffffff;
  --color-border: #d4e8d8;
  --color-gold-text: #6b3d08;
  --color-wallet-bg: #c5e8cb;
  --color-profile-sheet: #f4f6f5;
  --color-logout-bg: #efcbcb;
  --color-logout-text: #b44a56;
  --font-size-title: 32rpx;
  --font-size-body: 28rpx;
  /* 白条 ~100rpx + 转盘凸出 ~72rpx + 安全区；列表底部用这个避开 TabBar */
  --tab-bar-content-padding: calc(220rpx + env(safe-area-inset-bottom));
}

page {
  background: var(--color-bg);
  color: var(--color-text);
}

/*
  组件 styleIsolation: isolated，只能定位宿主。
  登录后 TabBar 叠在 page 底部，不占 flex 高度。
*/
tab-bar {
  display: block;
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
}
