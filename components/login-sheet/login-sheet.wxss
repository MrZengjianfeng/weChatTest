/**
 * 登录底栏弹窗样式
 *
 * 根节点 absolute 铺满父级 page，flex 底对齐：遮罩全屏，关闭按钮和面板贴底部。
 * 颜色跟首页品牌绿（#0b4f36）和主按钮 --color-primary-dark；间距字号用 rpx。
 * styleIsolation: isolated，这些类不会漏到页面，页面也不能直接改内部样式。
 *
 * 交互态：--error 红框给必填空项；发码中按钮转圈；--disabled 给发码倒计时和登录请求中。
 */

/* 铺满 page；justify flex-end 让关闭按钮和面板靠底。pointer-events 打开后才能点 */
.login-sheet {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  pointer-events: auto;
}

/* 全屏半透明黑遮罩，点它关闭。absolute 铺满，不占 flex 高度 */
.login-sheet__mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
}

/* 面板外右上角关闭：相对根节点 flex 底对齐，所以出现在白面板上方 */
.login-sheet__close {
  position: relative;
  z-index: 2;
  width: 64rpx;
  height: 64rpx;
  margin: 0 32rpx 20rpx 0;
  align-self: flex-end;
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-sheet__close-icon {
  width: 32rpx;
  height: 32rpx;
}

/* 白面板：上圆角、底部安全区；overflow hidden 裁掉圆角外的内容 */
.login-sheet__panel {
  position: relative;
  z-index: 1;
  background: #ffffff;
  border-top-left-radius: 40rpx;
  border-top-right-radius: 40rpx;
  overflow: hidden;
  padding: 12rpx 40rpx calc(28rpx + env(safe-area-inset-bottom));
}

/* 顶部装饰拖动条，居中，暂无手势 */
.login-sheet__handle {
  width: 128rpx;
  height: 8rpx;
  margin: 8rpx auto 28rpx;
  border-radius: 8rpx;
  background: #1a1a1a;
}

/* 标题栏：返回键 + Login 文案同一行 */
.login-sheet__header {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 40rpx;
}

/* 返回键固定点击热区，flex-shrink 避免被标题挤扁 */
.login-sheet__back {
  width: 56rpx;
  height: 56rpx;
  margin-right: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.login-sheet__back-icon {
  width: 40rpx;
  height: 40rpx;
}

.login-sheet__title {
  font-size: 40rpx;
  font-weight: 700;
  color: #0b4f36;
  line-height: 56rpx;
}

.login-sheet__field {
  margin-bottom: 28rpx;
}

/* 标签与「Password login / Code login」同一行两端对齐 */
.login-sheet__label-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.login-sheet__label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #0b4f36;
  line-height: 34rpx;
}

.login-sheet__switch {
  margin-bottom: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #0b4f36;
  line-height: 34rpx;
}

/* 输入行：固定高度，左右图标/区号不压缩，中间 input 吃剩余宽度 */
.login-sheet__input-wrap {
  height: 88rpx;
  padding: 0 24rpx;
  border: 2rpx solid #e6e6e6;
  border-radius: 16rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  box-sizing: border-box;
}

/* 必填未填点 Send Code / Login：红框提示；聚焦后 class 去掉 */
.login-sheet__input-wrap--error {
  border-color: #e54545;
}

.login-sheet__prefix {
  font-size: 28rpx;
  color: #0b4f36;
  flex-shrink: 0;
}

.login-sheet__divider {
  width: 2rpx;
  height: 32rpx;
  margin: 0 20rpx;
  background: #e6e6e6;
  flex-shrink: 0;
}

.login-sheet__icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

/* 眼睛热区比图标大一圈，方便点；右边距清掉，避免和 input 抢空间 */
.login-sheet__eye {
  width: 56rpx;
  height: 56rpx;
  margin-left: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.login-sheet__eye .login-sheet__icon {
  margin-right: 0;
}

/* min-width:0 让 flex 子项可以缩，长号码不会把右侧图标顶出框 */
.login-sheet__input {
  flex: 1;
  height: 88rpx;
  min-width: 0;
  font-size: 28rpx;
  color: #0b4f36;
}

.login-sheet__send {
  margin-left: 12rpx;
  min-width: 140rpx;
  min-height: 40rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #0b4f36;
  text-align: right;
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-end;
}

/* 倒计时中不可点，灰色提示还要等多久 */
.login-sheet__send--disabled {
  color: #b0b0b0;
  font-weight: 500;
}

/* 发码请求中：微信同款圆弧 loading，旋转才看得出在转（Skyline 不适合用四边不同色的 border 圆环） */
.login-sheet__send-loading {
  width: 16px;
  height: 16px;
  flex-shrink: 0;
  background: transparent url("data:image/svg+xml,%3C%3Fxml version='1.0' encoding='UTF-8'%3F%3E%3Csvg width='80px' height='80px' viewBox='0 0 80 80' version='1.1' xmlns='http://www.w3.org/2000/svg' xmlns:xlink='http://www.w3.org/1999/xlink'%3E%3Ctitle%3Eloading%3C/title%3E%3Cdefs%3E%3ClinearGradient x1='94.0869141%25' y1='0%25' x2='94.0869141%25' y2='90.559082%25' id='linearGradient-1'%3E%3Cstop stop-color='%230b4f36' stop-opacity='0' offset='0%25'%3E%3C/stop%3E%3Cstop stop-color='%230b4f36' stop-opacity='0.3' offset='100%25'%3E%3C/stop%3E%3C/linearGradient%3E%3ClinearGradient x1='100%25' y1='8.67370605%25' x2='100%25' y2='90.6286621%25' id='linearGradient-2'%3E%3Cstop stop-color='%230b4f36' offset='0%25'%3E%3C/stop%3E%3Cstop stop-color='%230b4f36' stop-opacity='0.3' offset='100%25'%3E%3C/stop%3E%3C/linearGradient%3E%3C/defs%3E%3Cg stroke='none' stroke-width='1' fill='none' fill-rule='evenodd' opacity='0.9'%3E%3Cg%3E%3Cpath d='M40,0 C62.09139,0 80,17.90861 80,40 C80,62.09139 62.09139,80 40,80 L40,73 C58.2253967,73 73,58.2253967 73,40 C73,21.7746033 58.2253967,7 40,7 L40,0 Z' fill='url(%23linearGradient-1)'%3E%3C/path%3E%3Cpath d='M40,0 L40,7 C21.7746033,7 7,21.7746033 7,40 C7,58.2253967 21.7746033,73 40,73 L40,80 C17.90861,80 0,62.09139 0,40 C0,17.90861 17.90861,0 40,0 Z' fill='url(%23linearGradient-2)'%3E%3C/path%3E%3Ccircle id='Oval' fill='%230b4f36' cx='40.5' cy='3.5' r='3.5'%3E%3C/circle%3E%3C/g%3E%3C/g%3E%3C/svg%3E") no-repeat;
  background-size: 100%;
  animation: login-sheet-spin 1s linear infinite;
}

@keyframes login-sheet-spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

.login-sheet__agree {
  display: block;
  margin: 8rpx 0 32rpx;
  font-size: 22rpx;
  color: #b0b0b0;
  line-height: 32rpx;
}

.login-sheet__btn {
  height: 88rpx;
  border-radius: 16rpx;
  background: var(--color-primary-dark);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 登录请求进行中：半透明提示不可再点，真正防连点在 JS 的 isLoggingIn */
.login-sheet__btn--disabled {
  opacity: 0.6;
}

.login-sheet__footer {
  margin-top: 36rpx;
  padding: 0 8rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.login-sheet__link {
  font-size: 26rpx;
  font-weight: 600;
  color: #0b4f36;
}
