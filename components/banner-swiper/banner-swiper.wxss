.hero {
  position: relative;
  width: 100%;
  background: var(--color-primary-dark);
}

/* 整块都是滑动热区 */
.banner {
  width: 100%;
  height: 368rpx;
}

/* Skyline 下 swiper-item 默认不继承高度，不写死宽高则内部 image 会塌 */
.banner__slide {
  width: 100%;
  height: 100%;
}

.banner__item {
  width: 100%;
  height: 100%;
  box-sizing: border-box;
}

/* 高度用定值，避免 Skyline 下 100% 失效 */
.banner__image {
  display: block;
  width: 100%;
  height: 368rpx;
}

/* 叠在图片底部，避开搜索条叠层 */
.banner__dots {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 64rpx;
  z-index: 1;
  display: flex;
  flex-direction: row;
  justify-content: center;
  pointer-events: none;
}

.banner__dot {
  width: 12rpx;
  height: 12rpx;
  margin: 0 6rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.35);
}

.banner__dot--active {
  width: 24rpx;
  background: #ffffff;
}
