.game-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  padding: 16rpx 20rpx 0;
}

/* 三列：31.2% * 3 + 左右 margin 1.066% * 6 ≈ 100% */
.game-card {
  width: 31.2%;
  margin: 0 1.066% 16rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: #d7e4db;
}

.game-card__cover,
.game-card__placeholder {
  width: 100%;
  height: 218rpx;
}

.game-card__placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx;
  box-sizing: border-box;
}

.game-card__name {
  font-size: 26rpx;
  font-weight: 700;
  color: #ffffff;
  text-align: center;
}

.empty {
  padding: 80rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty__text {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}
