<view class="game-grid" wx:if="{{gameList.length}}">
  <view
    class="game-card"
    wx:for="{{gameList}}"
    wx:key="id"
    data-id="{{item.id}}"
    bind:tap="onTapItem"
  >
    <image
      wx:if="{{item.img}}"
      class="game-card__cover"
      src="{{item.img}}"
      mode="aspectFill"
    />
  </view>
</view>
<!-- 与 grid 互斥：有数据走格子，加载中不提示空，加载完仍为空才提示 -->
<view class="empty" wx:elif="{{!isLoading}}">
  <text class="empty__text">暂无游戏</text>
</view>
