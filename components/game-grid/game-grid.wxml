<!-- 请求中优先骨架：结构/class 与真实格子相同，避免占位和成品对不齐 -->
<view class="game-grid" wx:if="{{isLoading}}">
  <view class="game-card" wx:for="{{skeletonList}}" wx:key="*this">
    <view class="game-card__cover"></view>
  </view>
</view>
<block wx:elif="{{gameList.length}}">
  <view class="game-grid">
    <view
      class="game-card"
      wx:for="{{gameList}}"
      wx:key="id"
      data-id="{{item.id}}"
      bind:tap="onTapItem"
    >
      <image
        wx:if="{{item.img}}"
        class="game-card__cover"
        src="{{item.img}}"
        mode="aspectFill"
      />
      <view wx:else class="game-card__cover"></view>
    </view>
  </view>
  <view class="game-grid-status">
    <text wx:if="{{loadingMore}}" class="game-grid-status__text">加载中...</text>
    <text wx:elif="{{!hasMore}}" class="game-grid-status__text">没有更多了</text>
  </view>
</block>
<empty-state wx:else></empty-state>
