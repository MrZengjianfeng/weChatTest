<view class="category">
  <!-- Skyline 横向 scroll-view 必须带 type，且子节点直接作为列表项 -->
  <scroll-view
    class="category__scroll"
    type="list"
    scroll-x
    show-scrollbar="{{false}}"
  >
    <view
      class="category__tag {{item.id === activeId ? 'category__tag--active' : ''}}"
      wx:for="{{list}}"
      wx:key="id"
      data-id="{{item.id}}"
      bind:tap="onTapItem"
    >
      <image
        wx:if="{{item.icon}}"
        class="category__icon"
        src="{{item.icon}}"
        mode="aspectFit"
      />
      <text>{{item.name}}</text>
    </view>
  </scroll-view>
</view>
