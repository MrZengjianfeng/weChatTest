page {
  position: relative;
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--color-primary-deep);
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.profile {
  min-height: 100%;
  background: var(--color-profile-sheet);
}

.profile__body {
  position: relative;
  z-index: 1;
  margin-top: -72rpx;
  padding: 0 24rpx var(--tab-bar-content-padding);
}

profile-header,
vip-card,
wallet-card,
profile-menu {
  display: block;
  width: 100%;
}

profile-header {
  background: var(--color-primary-deep);
}

vip-card {
  margin-bottom: 24rpx;
}

wallet-card {
  margin-bottom: 16rpx;
}

.profile__logout {
  margin-top: 24rpx;
  height: 88rpx;
  border-radius: 20rpx;
  background: var(--color-logout-bg);
  color: var(--color-logout-text);
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.profile__logout--active {
  opacity: 0.85;
}
