/*
  首页布局（Skyline + 自定义导航）

  page 纵向 flex：导航 → 跑马灯 → scroll-view 吃剩余高度 → auth-bar 绝对定位叠在底部。
  滚动必须走 .scrollarea，不要改成普通 view overflow 滚动，否则 sticky-section 失效。
*/

page {
  /* 给 auth-bar 的 absolute 当参照；没有 relative 会跑到错误的包含块 */
  position: relative;
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--color-bg);
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.home,
.home-body {
  padding-bottom: 32rpx;
}

/* 底栏约 80rpx 按钮 + 16rpx 内边距 + 安全区；多留一点避免最后一行贴边 */
.home--unauth {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/*
  吸顶条铺满宽度，实心底挡住下方格子往上透出来。
  高度 88rpx 与 category-tabs / 骨架 tabs 对齐，切换加载时不要跳。
*/
.home-tabs {
  width: 100%;
  height: 88rpx;
  background: var(--color-bg);
}

/*
  跑马灯是 page 的 flex 子项。不写 flex-shrink: 0 会被 scroll-view 挤成 0 高度。
  骨架 notice 必须同高（64rpx），加载结束才不会把整页顶一下。
*/
notice-marquee,
.home-skeleton__notice {
  flex-shrink: 0;
  width: 100%;
}

/* ---------- 骨架：尺寸跟真实模块对齐，加载结束布局尽量不跳 ---------- */

.home-skeleton__bone {
  background: #d7e4db;
  animation: home-skeleton-pulse 1.4s ease-in-out infinite;
}

/* 对齐 notice-marquee 深色条 */
.home-skeleton__notice {
  height: 64rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: row;
  align-items: center;
  background: var(--color-primary-dark);
}

.home-skeleton__notice-bone {
  width: 70%;
  height: 28rpx;
  border-radius: 8rpx;
  background: rgba(245, 230, 163, 0.28);
}

/* 对齐 banner-swiper 宿主高度 */
.home-skeleton__banner {
  width: 100%;
  height: 368rpx;
  background: var(--color-primary-dark);
}

/* 对齐 search-entry：负边距叠在轮播底部，z-index 盖住轮播下沿 */
.home-skeleton__search {
  display: flex;
  flex-direction: row;
  align-items: center;
  height: 80rpx;
  margin: -40rpx 40rpx 0;
  padding: 0 28rpx;
  background: var(--color-surface);
  border-radius: 999rpx;
  box-shadow: 0 8rpx 24rpx rgba(11, 61, 46, 0.12);
  position: relative;
  z-index: 2;
  box-sizing: border-box;
}

.home-skeleton__search-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 16rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.home-skeleton__search-text {
  width: 240rpx;
  height: 28rpx;
  border-radius: 8rpx;
}

.home-skeleton__shortcuts {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  padding: 36rpx 20rpx 8rpx;
}

.home-skeleton__shortcut {
  width: 20%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 快捷入口图标在组件里是 44px（不是 rpx），骨架跟着用 px 才对齐 */
.home-skeleton__shortcut-icon {
  width: 44px;
  height: 44px;
  border-radius: 16rpx;
}

.home-skeleton__shortcut-label {
  width: 64rpx;
  height: 22rpx;
  margin-top: 12rpx;
  border-radius: 6rpx;
}

.home-skeleton__tabs {
  width: 100%;
  height: 88rpx;
  box-sizing: border-box;
  padding: 16rpx 24rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  overflow: hidden;
}

.home-skeleton__tab {
  height: 56rpx;
  width: 140rpx;
  margin-right: 16rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.home-skeleton__grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  padding: 16rpx 20rpx 0;
}

/* 约三列：31.2% + 左右 1.066% margin，和 game-grid 卡片宽高接近 */
.home-skeleton__card {
  width: 31.2%;
  height: 218rpx;
  margin: 0 1.066% 16rpx;
  border-radius: 20rpx;
}

@keyframes home-skeleton-pulse {
  0%,
  100% {
    opacity: 1;
  }
  50% {
    opacity: 0.45;
  }
}

/*
  Skyline 自定义组件宿主默认可能量不到宽高。
  轮播必须写死 368rpx，否则 swiper 高度为 0。
*/
banner-swiper {
  display: block;
  width: 100%;
  height: 368rpx;
}

category-tabs,
sticky-section,
sticky-header {
  display: block;
  width: 100%;
}

/*
  组件 styleIsolation: isolated，页面只能定位自定义组件宿主。
  写在组件内部的 position 出不来，底栏会跟着文档流走。
*/
auth-bar {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
}
