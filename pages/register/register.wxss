page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #ffffff;
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.container {
  padding: 80rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hint {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}
