page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--color-bg);
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.container {
  padding: 32rpx 32rpx 0;
}

.search-field {
  display: flex;
  flex-direction: row;
  align-items: center;
  height: 80rpx;
  padding: 0 28rpx;
  background: #ffffff;
  border-radius: 999rpx;
}

.search-field__icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.search-field__input {
  flex: 1;
  height: 80rpx;
  font-size: 28rpx;
}

.search-field__placeholder {
  color: #9aaba0;
  font-size: 26rpx;
}

.hint {
  display: block;
  margin-top: 32rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  text-align: center;
}
