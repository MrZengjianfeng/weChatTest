page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #ffffff;
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.container {
  padding: 80rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hint {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  margin-bottom: 48rpx;
}

.btn {
  width: 100%;
  height: 88rpx;
  border-radius: 16rpx;
  background: var(--color-primary);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}
